# Application
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite is the currently supported database backend.
# Relative paths are resolved from the repository root.
DATABASE_URL=sqlite:///database/university.db

# Comma-separated browser origins allowed to call the API. In development,
# localhost and 127.0.0.1 are additionally accepted on any port.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional writable runtime storage. Relative paths use the repository root.
UPLOAD_DIR=backend/backend/uploads
LIBRARY_BOOKS_DIR=frontend/Admin_dashboard/Books

# Optional AI providers. Leave unused providers blank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_TOKENS=1024

# Timetable document retrieval
TIMETABLE_EMBEDDING_PROVIDER=hash
TIMETABLE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
