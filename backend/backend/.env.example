APP_NAME=Zero-Trust Autonomous Campus Ecosystem Using Multi-Agent AI
APP_ENV=development
DEBUG=True

DATABASE_URL=sqlite:///../../../database/university.db

SECRET_KEY=UniversityERP_2026_Secure_Secret_Change_Later
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================================
# AI ACADEMIC ASSISTANT PROVIDERS CONFIGURATION
# ==========================================================
# Fallback priority: Groq -> Gemini -> Hugging Face -> Ollama -> Direct DB Assistant

# 1. Groq (Fast cloud LLMs: llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (gemini-2.0-flash, gemini-1.5-flash, etc.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. Hugging Face Inference API
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# 4. Local Ollama (Runs on your PC)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=30